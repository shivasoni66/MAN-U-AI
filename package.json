{
  "name": "man-u-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:web": "pnpm --filter @man-u-ai/web dev",
    "dev:admin": "pnpm --filter @man-u-ai/admin dev",
    "dev:manager": "pnpm --filter @man-u-ai/manager dev",
    "dev:portal": "pnpm --filter @man-u-ai/portal dev",
    "dev:api": "pnpm --filter @man-u-ai/api dev",
    "build": "pnpm -r build",
    "build:admin": "pnpm --filter @man-u-ai/admin build",
    "build:manager": "pnpm --filter @man-u-ai/manager build",
    "build:portal": "pnpm --filter @man-u-ai/portal build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:admin": "pnpm --filter @man-u-ai/admin test",
    "test:manager": "pnpm --filter @man-u-ai/manager test",
    "clean": "pnpm -r exec -- rimraf dist node_modules .turbo"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
